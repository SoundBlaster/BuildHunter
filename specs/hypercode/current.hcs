  folded_into: "buildhunter.current.scan"
StartupAdmission:
  implementation: "host root guard admission + profile/QoS/channel setup"
  folded_into: "buildhunter.current.scan"
ScopedLaunch:
  implementation: "run_scoped_workers with host sampler/worker/coordinator closures"
  folded_into: "buildhunter.current.scan"
TerminalPublication:
  implementation: "final status/profiles and Finished after join; admission failure early path"
  folded_into: "buildhunter.current.scan"
Traversal:
  implementation: "Scanner + host WorkerAdapter + Hunter directory-worker/listing/queue/spawn/visit_directory"
  folded_into: "buildhunter.current.scan"
Measurement:
  implementation: "measurement::measure_directory + Hunter measure_with; worker owns timing/guard"
