NativeMeasurementBackend:
  source: "src/measurement.rs"
  implementation: "MetadataBackend directory/prepared-state adapter"
  folded_into: "buildhunter.current.scan"
BatchPreparation:
  implementation: "optional local bulk metadata + test injections; preparation before slot cancellation"
  folded_into: "buildhunter.current.scan"
MetadataFallback:
  implementation: "PreparedFiles consumes batch entries, native fallback/error decoration/counters"
