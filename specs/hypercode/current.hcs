ScanSession:
  source: "src/scan_session.rs"
  folded_into: "buildhunter.current.scan"
StartupAdmission:
  implementation: "host guard/backend choice through with_scan_session + profile/QoS/channel setup"
  folded_into: "buildhunter.current.scan"
ScopedLaunch:
  implementation: "consuming Hunter ScanSession::run_engine with host worker/helpers/factory/collection callbacks"
  folded_into: "buildhunter.current.scan"
TerminalPublication:
  implementation: "final status/profiles and Finished after join; admission failure early path"
  folded_into: "buildhunter.current.scan"
Traversal:
  implementation: "ArtifactHandler ScanHandler selects/schedules; Hunter ScanEngine owns serial branch routing/task mechanics"
  folded_into: "buildhunter.current.scan"
Measurement:
  implementation: "worker measure_with + ScanEngine deferred/immediate selected resolution; ArtifactHandler owns aggregation"
  folded_into: "buildhunter.current.scan"
NativeMeasurementBackend:
  source: "src/measurement.rs"
  implementation: "MetadataBackend directory/prepared-state adapter"
  folded_into: "buildhunter.current.scan"
BatchPreparation:
  implementation: "host chooses optional Hunter acquisition, records counters/test hooks; preparation before slot cancellation"
  folded_into: "buildhunter.current.scan"
MetadataFallback:
  implementation: "Hunter consumes batch entries; PreparedFiles keeps injected errors, portable fallback/error decoration/counters"
  folded_into: "buildhunter.current.scan"
CloudGuard:
  source: "src/materialization.rs"
  implementation: "compatibility alias; native-only dataless error decoration, scoped errors unchanged; native guard lives in Hunter"
  folded_into: "buildhunter.current.scan"
ResourceProfile:
  source: "src/profile.rs"
  implementation: "host cadence/baseline/delta/summary; raw process reads via Hunter"
  folded_into: "buildhunter.current.scan"
ArtifactClassification:
  source: "src/client_scan.rs"
  parity_fixture: "tests/fixtures/migration-parity-v1.json; client-specific expected rows"
  boundary_spec: "buildhunter.current.classification"
CandidateSelection:
  implementation: "scan_client every-node observer + conservative catalog dispatch; legacy gate bypassed"
  folded_into: "buildhunter.current.classification"
MarkerVocabulary:
  implementation: "enabled plugin bindings -> per-candidate marker requests; legacy-file-markers/1 compatibility acquisition"
  folded_into: "buildhunter.current.classification"
ClientPolicy:
  source: "src/client_scan.rs"
  implementation: "CLI profile admission + CatalogSnapshot CliV1/Rifle classification"
  environments_default: false
  folded_into: "buildhunter.current.classification"
FilterCatalog:
  implementation: "validated plugin target descriptors; legacy JSON supplies ordering/matching hints only"
  folded_into: "buildhunter.current.classification"
RustSwiftBridge:
