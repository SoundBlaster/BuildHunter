  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.portable (upstream draft)"
  distribution: "exact vendored std-only path dependency"
DirectoryEnumeration:
  implementation: "visit_directory; host owns opened iterator and recursion"
  folded_into: "buildhunter.current.scan"
MetadataSizing:
  implementation: "metadata_bytes + MeasuredSize; metadata acquired by host"
  folded_into: "buildhunter.current.scan"
HunterWork:
  source: "vendor/hunter-fs-core/src/work.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.work (upstream draft)"
TaskScheduling:
  implementation: "WorkQueue<ListTask>, host owns task/recursion decisions"
  folded_into: "buildhunter.current.scan"
WorkerLifecycle:
  implementation: "run_scoped_workers owns shutdown guard/helper stop/launch; actual scope joins"
  folded_into: "buildhunter.current.scan"
HunterDirectoryTasks:
  source: "vendor/hunter-fs-core/src/task.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.directory_tasks (upstream draft)"
TaskContext:
  implementation: "DirectoryTask/ListTask + DirectoryListing; opaque host u32 contexts"
  folded_into: "buildhunter.current.scan"
PositionalMeasurement:
  implementation: "measurement_plan + measure/measure_with; guarded host typed or callback backends"
  folded_into: "buildhunter.current.scan"
ResultEnvelope:
  implementation: "DirectoryResult; host publishes Listed before Measured"
  folded_into: "buildhunter.current.scan"
HunterChildTraversal:
  source: "vendor/hunter-fs-core/src/children.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.child_traversal (upstream draft)"
ChildAdmission:
  implementation: "ChildTraversal::next_child; host checkpoint/stop/cloud decisions"
  folded_into: "buildhunter.current.scan"
RecursiveRequests:
  implementation: "DirectoryRequest::into_task + host enqueue/node/ancestor accounting"
  folded_into: "buildhunter.current.scan"
HunterTaskLedger:
  source: "vendor/hunter-fs-core/src/ledger.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.task_ledger (upstream draft)"
TaskIdentity:
  implementation: "DirectoryTaskLedger::register + take_listing"
  folded_into: "buildhunter.current.scan"
ResponseAccounting:
  implementation: "response_received/outstanding + host profile mirror/dispatch ordering"
  folded_into: "buildhunter.current.scan"
DeferredState:
  implementation: "defer_measurement/take_measurement; opaque DirNode/PendingMeasure"
  folded_into: "buildhunter.current.scan"
HunterSubtreeProgress:
  source: "vendor/hunter-fs-core/src/subtree.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.subtree_progress (upstream draft)"
ByteAggregation:
  implementation: "SubtreeProgress::add_bytes/set_bytes; host ancestor routing and size units"
  folded_into: "buildhunter.current.scan"
CompletionReadiness:
  implementation: "pending-directory/root accounting + is_ready; host reverse-chain ordering"
  folded_into: "buildhunter.current.scan"
PartialCompletion:
  implementation: "mark_partial + complete(force_partial); host publishes ArtifactCompleted"
  folded_into: "buildhunter.current.scan"
HunterScanExecution:
  source: "vendor/hunter-fs-core/src/execution.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.scan_execution (upstream draft)"
ResultPump:
  implementation: "drive_scan + local Scanner ScanCoordinator; opaque WorkerMessage"
  folded_into: "buildhunter.current.scan"
IdleCheckpoint:
  implementation: "profile interval recv_timeout; checkpoint drains sampler messages"
  folded_into: "buildhunter.current.scan"
StopBoundary:
  implementation: "ledger retirement/profile sync before stop; product dispatch only while running"
  folded_into: "buildhunter.current.scan"
HunterFilesystemBackend:
  source: "vendor/hunter-fs-core/src/backend.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.backend (upstream draft)"
NativePathAccess:
  implementation: "StdFilesystem + guarded local Probes trait implementation; marker/bulk exceptions stay local"
  folded_into: "buildhunter.current.scan"
RootInitialization:
  implementation: "observe_root; host admits/schedules root and reuses owned metadata"
  folded_into: "buildhunter.current.scan"
HunterDirectoryWorker:
  source: "vendor/hunter-fs-core/src/worker.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.directory_worker (upstream draft)"
TaskExecution:
  implementation: "run_directory_worker + local WorkerAdapter; guard retained outside loop"
  folded_into: "buildhunter.current.scan"
ListingFirst:
  implementation: "Listed publication before local guarded measurement, then Measured including cancellation prefix"
  folded_into: "buildhunter.current.scan"
PublicationBoundary:
  implementation: "failed channel send stops before next measurement/task; outer host closes queue"
  folded_into: "buildhunter.current.scan"
HunterDirectoryListing:
  source: "vendor/hunter-fs-core/src/listing.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.directory_listing (upstream draft)"
OrderedCollection:
  implementation: "collect_directory over host-opened entries; ordered owned children/errors"
  folded_into: "buildhunter.current.scan"
ContextObservation:
  implementation: "observe_legacy_marker updates local context per entry; observer failure retains child"
  folded_into: "buildhunter.current.scan"
AcquisitionOutcome:
  implementation: "unchanged DirectoryVisit outcomes; host retains post-list hook and status"
  folded_into: "buildhunter.current.scan"
HunterMeasurementBackend:
  source: "vendor/hunter-fs-core/src/measurement.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.measurement_backend (upstream draft)"
DirectoryPreparation:
  implementation: "measure_with: directory_metadata then prepare_files, including error/pre-cancel"
  folded_into: "buildhunter.current.scan"
PreparedFileEffects:
  implementation: "owned FileMeasurementBackend state; host native/bulk policy and guards"
  folded_into: "buildhunter.current.scan"
SharedSlotExecution:
  implementation: "typed and closure task APIs share measure_prepared; original slots and partial prefix"
  folded_into: "buildhunter.current.scan"
HunterScopedSession:
  source: "vendor/hunter-fs-core/src/session.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.scoped_session (upstream draft)"
HelperStartup:
  implementation: "start host helpers before workers and caller-thread coordinator"
  folded_into: "buildhunter.current.scan"
QueueShutdown:
  implementation: "helper guard drop then close_on_drop, before join"
  folded_into: "buildhunter.current.scan"
JoinBoundary:
  implementation: "coordinator captures/receiver release before join; result after scoped completion"
  folded_into: "buildhunter.current.scan"
HunterMetadata:
  source: "specs/evidence/hunter-parent-review-20261014/upstream/scoped_metadata.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "5c8f3c9a1a018039b5aea9b731f2fb744f625b5a"
  boundary_spec: "hunter.fs.scoped_metadata (upstream draft)"
  implemented_scope: "Unix scoped regular-file metadata only; full scanner pending"
MarkerAcquisition:
  source: "crates/buildhunter-plugin-scanner/src/scope.rs"
  implemented_scope: "product mapping to pinned hunter-fs; traversal races not covered"
  folded_into: "buildhunter.plugin.scanner"
TargetRouting:
  source: "crates/buildhunter-plugin-scanner/src/lib.rs"
  folded_into: "buildhunter.plugin.scanner"
@client[gui]:
  BuildHunterRuntime:
    entrypoint: "macos/Sources/BuildHunter/UI/BuildHunterApp.swift"
    profile: "gui"
  ClientPolicy:
    source: "macos/Sources/BuildHunter/Domain/ClassifyArtifactRoot.swift"
    implementation: "BuildHunterScanPolicy + SpecificationCore"
    environments_default: true
@contract:
  BuildHunterRuntime:
    baseline: string
    status: string
    entrypoint: string
  Scanner:
    source: string
    boundary_spec: string
  ClientPolicy:
    environments_default: bool
  EventChannel:
    capacity: int >= 1 <= 4096
HunterRootAdmission:
  source: "vendor/hunter-fs-core/src/admission.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.root_admission (upstream draft)"
HostRootPreflight:
  implementation: "host cloud_skip_reason before backend metadata; guards stay local"
  folded_into: "buildhunter.current.scan"
RootAdmissionOutcome:
  implementation: "opaque Skipped/Observed/Unavailable; host return/pump/scheduling/status"
  folded_into: "buildhunter.current.scan"
HunterBackendLifetime:
  source: "vendor/hunter-fs-core/src/lifetime.rs"
  upstream_repository: "SoundBlaster/Hunter"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.backend_lifetime (upstream draft)"
GuardedPreparation:
  implementation: "enter guard then prepare borrowed Probes or owned WorkerAdapter"
  folded_into: "buildhunter.current.scan"
BackendRelease:
  implementation: "owned adapter drops before same-thread guard on return/unwind; coordinator joins first"
  folded_into: "buildhunter.current.scan"
ThreadMaterializationPolicy:
  source: "vendor/hunter-fs-core/src/materialization.rs"
  implementation: "Hunter NonMaterializingIoGuard, Darwin thread read/set/restore, no-op elsewhere"
  folded_into: "buildhunter.current.scan"
HunterScanAssembly:
  source: "vendor/hunter-fs-core/src/assembly.rs"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.scan_assembly (upstream draft)"
GuardedQueue:
  implementation: "with_scan_session; owned queue and capped parallelism inside backend scope"
SingleLaunch:
  implementation: "consuming ScanSession::run; scoped helpers/workers/coordinator join"
HostFinalization:
  source: "src/scan_session.rs"
  implementation: "final Profile/Finished after join, before backend/guard release"
ArtifactInterpretation:
  source: "src/lib.rs"
  implementation: "ArtifactHandler implements TraversalHandler; no owned queue/ledger"
  folded_into: "buildhunter.current.scan"
HunterTraversalCoordinator:
  source: "vendor/hunter-fs-core/src/coordinator.rs"
  upstream_revision: "10268f69c41890bb23ab4cdc33d25f3aac8e46d1"
  boundary_spec: "hunter.fs.traversal_coordinator (upstream draft)"
CoordinatorRootAdmission:
  implementation: "original preflight/observation then ArtifactHandler initialize"
OwnedTaskAccounting:
  implementation: "TraversalTasks owns ledger; queue borrowed from guarded ScanSession"
HostInterpretation:
  implementation: "caller-thread opaque host callbacks and partial finalization; not product status or join"
