SigningAndRelease:
  folded_into: "buildhunter.design.product"
@edition[store]:
  HunterProducts:
    profile: "store"
  BuildHunter:
    catalog: "public-basic-plus-Arsenal"
@contract:
  HunterProducts:
    status: string
    baseline: string
  Hunter:
    repository: string
    implemented_as_module: bool
  Rifle:
    repository: string
    implemented_as_module: bool
  Arsenal:
