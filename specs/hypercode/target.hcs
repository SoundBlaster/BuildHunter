# Approved names; proposed contracts and repositories, no extraction claimed.
HunterProducts:
  status: "target-design-draft"
  baseline: "specs/validation/plugin-scanner-20261014/source-identity.json"
  profile: "public"
Hunter:
  boundary_spec: "hunter.design.scan"
  repository: "Hunter"
  visibility: "public"
  implemented_as_module: false
  filesystem_effects: true
  artifact_vocabulary: false
Rifle:
  boundary_spec: "rifle.design.rules"
  repository: "Rifle"
  visibility: "public"
  implemented_as_module: true
  implemented_scope: "pure-program-generic-catalog-identity; Swift SDK pending"
  filesystem_effects: false
  artifact_vocabulary: false
BuildHunter:
  boundary_spec: "buildhunter.design.product"
  repository: "BuildHunter"
  visibility: "public"
  implemented_as_target_assembly: false
  catalog: "public-basic"
Arsenal:
  boundary_spec: "arsenal.design.catalog"
  repository: "Arsenal"
  visibility: "private"
  implemented_as_module: false
StoreDistribution:
  folded_into: "buildhunter.design.product"
  repository: "BuildHunterMAS"
  status: "repository-created-pipeline-pending"
Traversal:
  folded_into: "hunter.design.scan"
MetadataMeasurement:
  folded_into: "hunter.design.scan"
