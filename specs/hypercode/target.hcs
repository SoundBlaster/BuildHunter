  folded_into: "hunter.design.scan"
RuleModel:
  folded_into: "rifle.design.rules"
CatalogValidation:
  folded_into: "rifle.design.rules"
PlanCompilation:
  folded_into: "rifle.design.rules"
Evaluation:
  folded_into: "rifle.design.rules"
SwiftAuthoring:
  folded_into: "rifle.design.rules"
BasicPlugins:
  folded_into: "buildhunter.design.product"
ArtifactPolicy:
  folded_into: "buildhunter.design.product"
ScanAssembly:
  folded_into: "buildhunter.design.product"
CommandLine:
  folded_into: "buildhunter.design.product"
MacApplication:
  folded_into: "buildhunter.design.product"
CommercialPlugins:
