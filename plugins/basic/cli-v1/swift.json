{
  "format": "buildhunter.plugin/1-draft.1",
  "id": "org.buildhunter.swift",
  "version": "1.0.0",
  "title": "Swift basic checks",
  "description": "Bundled public basic catalog. Client profile: cli-v1.",
  "program": {
    "format": "rifle.program/1-draft.1",
    "facts": [
      {
        "id": "kind",
        "type": "string"
      },
      {
        "id": "name",
        "type": "string"
      }
    ],
    "rules": [
      {
        "id": "swift-build",
        "when": {
          "all": [
            {
              "fact": "kind",
              "op": "eq",
              "value": "directory"
            },
            {
              "fact": "name",
              "op": "eq",
              "value": ".build"
            }
          ]
        }
      }
    ]
  },
  "bindings": {
    "kind": {
      "source": "node.kind"
    },
    "name": {
      "source": "node.name"
    }
  },
  "targets": [
    {
      "id": "swift.build",
      "title": "Swift build output",
      "ecosystem": "swift",
      "kind": "build_output",
      "ruleIds": [
        "swift-build"
      ]
    }
  ]
}
