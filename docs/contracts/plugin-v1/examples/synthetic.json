{
  "format": "buildhunter.plugin/1-draft.1",
  "id": "example.forge",
  "version": "1.0.0",
  "title": "Synthetic Forge output",
  "description": "Contract example; not an installed plugin.",
  "program": {
    "format": "rifle.program/1-draft.1",
    "facts": [
      {
        "id": "name",
        "type": "string"
      },
      {
        "id": "kind",
        "type": "string"
      },
      {
        "id": "project",
        "type": "boolean"
      }
    ],
    "rules": [
      {
        "id": "output",
        "when": {
          "all": [
            {
              "fact": "kind",
              "op": "eq",
              "value": "directory"
            },
            {
              "fact": "name",
              "op": "eq",
              "value": "forge-out"
            },
            {
              "fact": "project",
              "op": "eq",
              "value": true
            }
          ]
        }
      }
    ]
  },
  "bindings": {
    "name": {
      "source": "node.name"
    },
    "kind": {
      "source": "node.kind"
    },
    "project": {
      "source": "marker",
      "scope": "parent",
      "name": "forge.project"
    }
  },
  "targets": [
    {
      "id": "example.forge-output",
      "title": "Synthetic Forge output",
      "ecosystem": "example",
      "kind": "build_output",
      "ruleIds": [
        "output"
      ]
    }
  ]
}
