  folded_into: "hunter.fs.root_admission"
BackendLifetime:
  source: "crates/hunter-fs-core/src/lifetime.rs"
  boundary_spec: "hunter.fs.backend_lifetime"
GuardedPreparation:
  implementation: "enter guard, prepare backend, run borrowed body on caller thread"
